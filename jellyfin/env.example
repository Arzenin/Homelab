# Jellyfin Internal Port (default is 8096)
JELLYFIN_PORT=8096

# Timezone (e.g., Europe/Madrid, America/New_York)
TZ=Region/City

# Absolute paths to your data directories on the host machine
CONFIG_DIR=/path/to/your/jellyfin/config
CACHE_DIR=/path/to/your/jellyfin/cache
MEDIA_DIR=/path/to/your/jellyfin/media

# Path to your Calibre library (mounted read-only inside Jellyfin)
BOOKS_DIR=/path/to/your/calibre/books
