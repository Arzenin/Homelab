# Netdata stack - environment variables template
# Copy this file to ".env" and replace the placeholder values:
#   cp env.example .env && chmod 600 .env
# This template contains NO real data. Never commit the real ".env" file.

NETDATA_VERSION=stable
# Netdata image tag to use (stable, edge, or a specific version such as v2.0.0)

TZ=Europe/Madrid
# Timezone used inside the container (TZ database name)

NETDATA_HOSTNAME=my-server
# Hostname shown in the Netdata dashboard

NETDATA_HOST_PORT=00000
# Host port exposed for the web UI (the container always listens on 19999).
# Choose a port that is free on the host: ss -tulpn | grep <port>

NETDATA_BIND_IP=0.0.0.0
# Host IP the web UI port is bound to.
# 0.0.0.0 = all interfaces, a LAN IP = only that interface, 127.0.0.1 = local only

NETDATA_CONFIG_DIR=/path/to/netdata/config
# Host directory for Netdata configuration files (mounted at /etc/netdata)

NETDATA_LIB_DIR=/path/to/netdata/lib
# Host directory for the Netdata database and internal state (mounted at /var/lib/netdata)

NETDATA_CACHE_DIR=/path/to/netdata/cache
# Host directory for the Netdata cache (mounted at /var/cache/netdata)

DOCKER_GID=0
# GID of the "docker" group on the host, so Netdata can read Docker metrics.
# Get it with: getent group docker | cut -d: -f3

NETDATA_DO_NOT_TRACK=1
# 1 = disable anonymous telemetry sent to Netdata, 0 = allow it

NETDATA_CLAIM_TOKEN=
# OPTIONAL. Netdata Cloud claim token (sensitive, treat it like a password).
# Leave empty to run Netdata fully local.

NETDATA_CLAIM_ROOMS=
# OPTIONAL. Netdata Cloud room ID(s) the node joins (comma separated)

NETDATA_CLAIM_URL=https://app.netdata.cloud
# OPTIONAL. Netdata Cloud URL (change only for a self-hosted Cloud)
