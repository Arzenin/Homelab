# Timezone
TZ=Europe/Madrid

# Pi-hole Credentials
FTLCONF_webserver_api_password=your_secure_password_here
PIHOLE_WEBUSER=your_username_here

# Port Mappings
PIHOLE_DNS_PORT_TCP=53
PIHOLE_DNS_PORT_UDP=53
PIHOLE_HTTP_PORT=80
PIHOLE_HTTPS_PORT=443

# Volume Host Paths
PIHOLE_ETC_PATH=/path/to/your/server/pihole/etc-pihole
PIHOLE_DNSMASQ_PATH=/path/to/your/server/pihole/etc-dnsmasq.d
